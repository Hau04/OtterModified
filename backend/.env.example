# Python backend configuration. Use backend/.env locally or /opt/otterhub/shared/otterhub.env on the VPS.
APP_ENV=production
# Required for production; the sample values are deliberately rejected at startup.
BASIC_USER=change-me
BASIC_PASS=replace-with-a-long-random-password

# Persistent VPS data directory; back up this directory to preserve files and metadata.
DATA_DIR=/var/lib/otterhub
DATABASE_PATH=/var/lib/otterhub/otterhub.sqlite3
STORAGE_DIR=/var/lib/otterhub/files
CHUNKS_DIR=/var/lib/otterhub/chunks

# The frontend is built as a static export and served by FastAPI on the same origin.
# In a source checkout the default is <repo>/frontend/out.
FRONTEND_DIR=/opt/otterhub/current/frontend/out

# 1 GiB max file, uploaded in 20 MiB chunks by the browser.
MAX_UPLOAD_SIZE_BYTES=1073741824
CHUNK_SIZE_BYTES=20971520
MAX_FILE_COUNT=1000

# Leave empty for same-origin deployment. For frontend dev on port 3000, set:
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

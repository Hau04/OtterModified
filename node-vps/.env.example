# Node.js VPS environment. Copy to node-vps/.env locally, or to
# /opt/otterhub/shared/otterhub.env on the VPS.
APP_ENV=production
NODE_ENV=production

# Required for production; these placeholders are rejected at startup.
BASIC_USER=change-me
BASIC_PASS=replace-with-a-long-random-password

# Store uploaded file bytes in the Telegram chat, as in the original Worker adapter.
# Keep the bot token private; use the exact chat ID returned by Telegram (including -100 if present).
STORAGE_BACKEND=telegram
TG_BOT_TOKEN=
TG_CHAT_ID=
TELEGRAM_TIMEOUT_MS=60000

# Keep Node bound to loopback behind Nginx.
HOST=127.0.0.1
PORT=8000

# Persistent storage: back up this directory together with the SQLite database.
DATA_DIR=/var/lib/otterhub
DATABASE_PATH=/var/lib/otterhub/otterhub.sqlite3
STORAGE_DIR=/var/lib/otterhub/files
CHUNKS_DIR=/var/lib/otterhub/chunks
TEMP_UPLOAD_DIR=/var/lib/otterhub/uploads

# Next.js static export shipped in each release.
FRONTEND_DIR=/opt/otterhub/current/frontend/out

# 1 GiB per file; browser uploads files as 20 MiB chunks (50 chunks max).
MAX_UPLOAD_SIZE_BYTES=1073741824
CHUNK_SIZE_BYTES=20971520
MAX_CHUNK_COUNT=50
MAX_FILE_COUNT=1000

# Leave empty for same-origin. For a separate dev frontend, list exact origins.
CORS_ORIGINS=

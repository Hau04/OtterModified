[Unit]
Description=OtterHub Node.js API and static frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otterhub
Group=otterhub
WorkingDirectory=/opt/otterhub/current/node-vps
EnvironmentFile=/opt/otterhub/shared/otterhub.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/otterhub/current/node-vps/src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/otterhub

[Install]
WantedBy=multi-user.target
